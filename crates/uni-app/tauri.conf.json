{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universe",
  "identifier": "io.github.origin-foundry.universe",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist",
    "beforeDevCommand": { "script": "npm run ui:dev", "cwd": "../.." },
    "beforeBuildCommand": { "script": "npm run ui:build", "cwd": "../.." }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Universe",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
